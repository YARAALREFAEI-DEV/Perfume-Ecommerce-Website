    <style>

        .hero-heading {
            text-align: center;
            margin-top: 40px;
            margin-bottom: 30px;
        }

            .hero-heading h2 {
                font-size: 3rem;
                font-family: 'Playfair Display', serif;
                font-weight: 600;
                color: #3a2c27;
                position: relative;
                display: inline-block;
                padding-bottom: 10px;
            }

                .hero-heading h2::after {
                    content: '';
                    width: 60%;
                    height: 3px;
                    background: #c9a06c;
                    position: absolute;
                    bottom: 0;
                    left: 50%;
                    transform: translateX(-50%);
                    border-radius: 5px;
                }

        #imageSlider {
            position: relative;
            width: 100vw;
            height: 40rem;
            overflow: hidden;
            margin: 40px 0;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 600px;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 1s ease-in-out;
            filter: brightness(1);
            border-radius: 0;
        }

            .slide.active {
                opacity: 1;
                animation: shine 3s ease-in-out infinite;
            }

    
    </style>

    <script>
        (function() {
            const slides = document.querySelectorAll('#imageSlider .slide');
            let current = 0;

            function showSlide(index) {
                slides.forEach((slide, i) => {
                    slide.classList.toggle('active', i === index);
                });
            }

            function nextSlide() {
                current = (current + 1) % slides.length;
                showSlide(current);
            }

            showSlide(current);
            setInterval(nextSlide, 3000);
        })();
    </script>



