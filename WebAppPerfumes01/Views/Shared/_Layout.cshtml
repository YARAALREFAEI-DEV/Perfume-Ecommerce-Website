    <nav style="background-color: white; padding: 10px 0;">
        <div style="display: flex; justify-content: center; align-items: center; gap: 20px; flex-wrap: wrap;">
            <!-- اللوغو -->
            <div>
                <a id="logo" asp-action="Index" asp-controller="Home"
                   style="font-size: 1rem; font-family: 'Tempus Sans ITC'; text-decoration: none; color: black;">
                    @Localizer["SiteName"]
                </a>
            </div>
            <div style="position: relative;" id="menuWrapper">
                <button id="menuToggleBtn" style="background: none; border: none; font-size: 0.9rem; cursor: pointer;">
                    <i class="fas fa-bars"></i>
                </button>
                <ul id="mainMenu" class="mainMenu" style="display: none; position: absolute; top: 25px; left: 0; background: white; border: 1px solid #ccc; border-radius: 5px; padding: 5px; list-style: none; z-index: 100;">
                    <li><a href="/" style="display: block; padding: 5px 10px; color: black; text-decoration: none;font-size:0.9rem;">    @Localizer["Home"]</a></li>
                    <li><a href="/Products" style="display: block; padding: 5px 10px; color: black; text-decoration: none;font-size:0.9rem;">    @Localizer["Products"]</a></li>
                    <li>
                        <a href="/Home/Contact" style="display: block; padding: 5px 10px; color: black; text-decoration: none;font-size:0.9rem;">
                            @Localizer["contact"]
                        </a>
                    </li>
                </ul>
            </div>
            <script>
                const toggleBtn = document.getElementById("menuToggleBtn");
                const menu = document.getElementById("mainMenu");
                const menuWrapper = document.getElementById("menuWrapper");

                toggleBtn.addEventListener("click", function (e) {
                    e.stopPropagation();

                    // أغلق جميع القوائم المفتوحة أولاً
                    document.querySelectorAll(".mainMenu").forEach(m => {
                        if (m !== menu) m.style.display = "none";
                    });

                    // افتح أو أغلق القائمة الخاصة بهذا الزر
                    menu.style.display = menu.style.display === "block" ? "none" : "block";
                });

                // إغلاق القائمة عند الضغط خارجها
                document.addEventListener("click", function (event) {
                    if (!menuWrapper.contains(event.target)) {
                        menu.style.display = "none";
                    }
                });
            </script>


            <!-- Dropdown: Login/Register -->
            <div style="position: relative;">
                <button onclick="toggleDropdown('authMenu')" style="background: none; border: none; font-size: 0.9rem; cursor: pointer;">
