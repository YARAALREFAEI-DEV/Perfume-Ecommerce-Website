@model List<WebAppPerfumes01.Models.Product>
@using Microsoft.AspNetCore.Localization

@{
    Layout = "~/Views/Shared/partialLayout.cshtml";
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
<br />
<h2>@Localizer["resultserch"]</h2>

@if (!Model.Any())
{
    <p>@Localizer["result"]</p>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-6 col-sm-4 col-md-3 text-center mb-4">
                <a href="@Url.Action("Details", "Home", new { id = product.Id })">
                    <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid mb-2 zoom" />
                </a>
                <p>@product.Name</p>
                <p>@product.Price @Localizer["coin"]</p>
            </div>
        }
    </div>
}
