@using Microsoft.AspNetCore.Localization

@using WebAppPerfumes01.Models.ViewModels
@model OrderViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/partialLayout.cshtml";
}
@{
    var cartItems = Context.Session.GetObject<List<WebAppPerfumes01.Models.CartItem>>("Cart") ?? new List<WebAppPerfumes01.Models.CartItem>();

    int totalQuantity = cartItems.Sum(i => i.Quantity);
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
<br />
<br />

<h2>
    @Localizer["buy"]
</h2>
<br />
<form asp-action="SubmitOrder" asp-controller="Order" method="POST">
    <div class="form-group">
        <label asp-for="FirstName">
            @Localizer["fname"]
        </label>
        <input asp-for="FirstName" class="form-control"  required/>
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">
            @Localizer["lname"]

        </label>
        <input asp-for="LastName" class="form-control" required />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">
            @Localizer["email"]
        </label>
        <input asp-for="Email" class="form-control" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone">
            @Localizer["phone"]
        </label>
        <input asp-for="Phone" class="form-control" required />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="locationSelect">   @Localizer["address"]</label>
        <select asp-for="Location" class="form-control" id="locationSelect">
            <option value="">-- Select Location --</option>
            @foreach (var location in Model.DeliveryLocations)
            {
                <option value="@location.AreaName" data-price="@location.DeliveryFee">
                    @location.AreaName (@location.DeliveryFee.ToString("0.00")             @Localizer["coin"]
                    )
                </option>
            }
        </select>
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PaymentMethod">  @Localizer["payment1"]</label>
        <select asp-for="PaymentMethod" class="form-control">
            <option value="Cash">  @Localizer["payment2"]</option>
            @* <option value="Online">Credit/Debit Card</option> *@
        </select>
        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
    </div>

    <h4 style="margin-top: 20px; font-size: 1.2rem;"> @Localizer["cart"]</h4>
    <div style="display: flex; flex-direction: column; gap: 10px;">
        @foreach (var item in Model.CartItems)
        {
            <div style="display: flex; align-items: center; gap: 10px; background-color: #f4f4f4; padding: 10px; border-radius: 8px; font-size: 0.85rem;">
                <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" />
                <div style="display: flex; flex-direction: column;">
                    <strong>
                        <a href="@Url.Action("Details", "Home", new { id = item.ProductId })" class="product-name-link">@item.Name</a>
                    </strong>
                    <span> @Localizer["QTY"]: @item.Quantity</span>
                    <span> @Localizer["price"]: @item.Price  @Localizer["coin"]</span>
                    <span> @Localizer["sprice"]: @(item.Quantity * item.Price)  @Localizer["coin"]</span>
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <p><strong> @Localizer["prodctpric"]:</strong> <span id="productTotal">@Model.Total.ToString("0.00")</span>  
            @Localizer["coin"]
            </p>
        <p><strong>@Localizer["dcost"]:</strong> <span id="deliveryCost">0.00</span> @Localizer["coin"]</p>
        <p><strong>  @Localizer["tpric"]:</strong> <span id="grandTotal">@Model.Total.ToString("0.00")</span>  @Localizer["coin"]</p>
    </div>
    <input type="hidden" asp-for="TotalPrice" id="grandTotalInput" value="@Model.Total.ToString("0.00")" />
    <input type="hidden" asp-for="Quantity" id="totalQuantityInput" value="@totalQuantity" />

    <button style="background-color:black;" type="submit" class="btn btn-primary mt-3">
        @Localizer["pOrder"]
        
    </button>
	<p style="margin-left:7rem;margin-top:-3rem;"><a href="@Url.Action("Index", "Products")" class="btn btn-outline-dark btn-continue"> @Localizer["shopping1"] </a></p>

</form>


<script>
    const locationSelect = document.getElementById("locationSelect");
    const deliveryCostDisplay = document.getElementById("deliveryCost");
    const grandTotalDisplay = document.getElementById("grandTotal");
    const grandTotalInput = document.getElementById("grandTotalInput");

    const baseTotal = parseFloat(document.getElementById("productTotal").innerText);

    locationSelect.addEventListener("change", function () {
        const selectedOption = locationSelect.options[locationSelect.selectedIndex];
        const deliveryCost = parseFloat(selectedOption.getAttribute("data-price")) || 0;
        const grandTotal = baseTotal + deliveryCost;

        deliveryCostDisplay.innerText = deliveryCost.toFixed(3);
        grandTotalDisplay.innerText = grandTotal.toFixed(3);
        grandTotalInput.value = grandTotal.toFixed(3);
    });
</script>
<br />