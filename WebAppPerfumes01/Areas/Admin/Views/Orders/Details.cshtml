@model WebAppPerfumes01.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h1>Order Details</h1>

<!-- سكشن معلومات الطلب -->
<div class="order-info">
    <h3>Order Information</h3>
    <p><strong>Order ID:</strong> @Model.OrderId</p>
    <p><strong>Customer Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd")</p>
    <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
    <p><strong>Total Amount:</strong> @Model.TotalAmount ADE</p>
 
</div>

<hr />

<!-- سكشن تفاصيل المنتجات -->
<div class="order-details">
    <h3>Products in Order</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Product Image</th>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Price total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product.Id</td>

                    <td>
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" width="80" />
                    </td>
                    <td>@item.Product.Name</td>
                    <td>@item.Price ADE</td>
                    <td>@item.Quantity</td>
                    <td>@Model.TotalAmount ADE</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-primary">Back to Orders List</a>


































