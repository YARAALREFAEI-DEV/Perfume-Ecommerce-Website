@model IEnumerable<WebAppPerfumes01.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-dark">Perfumes</h2><br />
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add New Perfume
    </a>
</div>
<br />
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th style="text-align: center; padding-right: 5rem;">
                Photo
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Discount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
                <td>
                    @Html.Raw(string.Join("<br />", item.Description?.Split(' ').Select((word, index) => new { word, index })
                             .GroupBy(x => x.index / 5)
                             .Select(g => string.Join(" ", g.Select(x => x.word)))))
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="Product Image" style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Price) AED
                </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Discount) %
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
