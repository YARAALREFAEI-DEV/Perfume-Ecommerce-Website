@using WebAppPerfumes01.Models.ViewModels
@model UserDashboardViewModel

<div class="container mt-4">
    <h2>Welcome to Your Panel</h2>

    <h4>Your Orders:</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToShortDateString()</td>
                    <td>@order.TotalAmount ADE</td>
                    <td>


                        <a href="@Url.Action("OrderDetails", "CPanel", new { area = "User", id = order.OrderId })">
                            عرض التفاصيل
                        </a>


                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
