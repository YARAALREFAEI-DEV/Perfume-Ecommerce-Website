@model WebAppPerfumes01.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">My Profile</h4>
        </div>
        <div class="card-body">
            <form asp-action="UpdateProfile" asp-controller="CPanel" method="post">
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label class="form-label fw-bold">First Name:</label>
                    <input asp-for="fName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Last Name:</label>
                    <input asp-for="lName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email:</label>
                    <input asp-for="Email" class="form-control"  />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phone Number:</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Address:</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <button type="submit" class="btn btn-success mt-3">Save Changes</button>
            </form>
        </div>
    </div>
</div>
