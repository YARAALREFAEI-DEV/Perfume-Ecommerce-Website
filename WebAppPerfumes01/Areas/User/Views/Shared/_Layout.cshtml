<!DOCTYPE html>
<html>
<head>
	<title> User Panel Management</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- Bootstrap -->
	<link href="~/dashboard/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<!-- styles -->
	<link href="~/dashboard/css/styles.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">


</head>
<body style="background: linear-gradient(to right, #f8f9fa, #e0e0e0);background-repeat: no-repeat;
	  background-size: cover;background-color:white;	">
